APP_NAME=Analytiq
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/analytiq.db
# Generate a persistent secret in production. Local development generates one automatically.
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WORKER_MODE=embedded
MAX_WORKERS=2
ENABLE_DEMO=true
# Optional: selects/orders existing computed narrative evidence; analytics/planning remain deterministic.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MAX_UPLOAD_MB=50
MAX_DATASET_ROWS=100000
# Optional outside Docker: serve a production frontend build directly from FastAPI.
# STATIC_DIR=../frontend/dist
